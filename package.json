{
  "name": "markdown-as-one-tab",
  "displayName": "MarkDown As One Tab",
  "description": "打开 Markdown 文件时自动在右侧打开预览，切换离开时自动关闭预览",
  "version": "1.0.1",
  "publisher": "B-52405",
  "icon": "extension/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/B-52405/MarkdownAutoPreview"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "auto"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "lint": "eslint .",
    "package": "vsce package --out ./dist/",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/node": "22.x",
    "eslint": "^9.39.3"
  }
}
